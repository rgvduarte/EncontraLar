{
  "name": "encontralar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "EncontraLar — plataforma para encontrar lares e residências seniores em Portugal, com vagas em tempo real e previsão de vagas.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
